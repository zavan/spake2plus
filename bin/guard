#!/usr/bin/env bash
# Repo-wide guards that no single linter covers. Read-only.
#
#   bin/guard all [root]           every guard below (used by bin/check)
#   bin/guard toolchain [root]     the active rustc matches rust-toolchain.toml
#   bin/guard lint-configs [root]  lint config files exist only on the allowlist
#   bin/guard no-baselines [root]  no baseline, todo or ignore files
#   bin/guard em-dashes [root]     no em-dashes or en-dashes in any text file
#
# `root` defaults to the repo; bin/canaries points guards at planted fixtures.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"

# Directories no guard reads, wherever they are: build output, the fuzzer's
# corpus and findings, git internals and agent worktrees.
skipped=(target corpus artifacts coverage .git worktrees)

# The same, as grep's options and as find's.
grep_skips=()
find_skips=()
for dir in "${skipped[@]}"; do
  grep_skips+=("--exclude-dir=$dir")
  find_skips+=(-name "$dir" -o)
done

# Files under `root`, but not in a skipped directory.
files_under() {
  find "$1" \( "${find_skips[@]}" -false \) -prune -o -type f -print
}

toolchain() {
  local root="$1" want have
  want="$(sed -n 's/^channel = "\(.*\)"$/\1/p' "$root/rust-toolchain.toml")"
  have="$(rustc --version | cut -d' ' -f2)"
  if [ "$have" != "$want" ]; then
    echo "rustc is $have but rust-toolchain.toml pins $want. Run bin/setup (or use rustup)."
    return 1
  fi
}

# A nested lint config can switch any rule off for a subtree, so lint configs
# may exist only at these paths.
lint_configs() {
  local root="$1" failed=0 path rel
  while IFS= read -r path; do
    rel="${path#"$root"/}"
    case "$rel" in
      clippy.toml | deny.toml) continue ;;
    esac
    case "$(basename "$rel")" in
      clippy.toml | .clippy.toml | rustfmt.toml | .rustfmt.toml | deny.toml | .shellcheckrc) ;;
      config.toml | config) case "$rel" in */.cargo/* | .cargo/*) ;; *) continue ;; esac ;;
      *) continue ;;
    esac
    echo "lint config outside the allowlist in bin/guard: $rel"
    failed=1
  done <<EOF
$(files_under "$root")
EOF
  return "$failed"
}

# Baselines, todo lists and ignore files absorb findings instead of fixing
# them. This repo has none and gains none. (.ignore at the root is ripgrep's.)
no_baselines() {
  local root="$1" failed=0 path rel
  while IFS= read -r path; do
    rel="${path#"$root"/}"
    [ "$rel" = ".ignore" ] && continue
    case "$(basename "$rel")" in
      *baseline* | *Baseline* | *_todo.yml | *_todo.yaml | *.ignore | audit.toml) ;;
      *) continue ;;
    esac
    echo "baseline or ignore file: $rel (fix the findings instead)"
    failed=1
  done <<EOF
$(files_under "$root")
EOF
  return "$failed"
}

em_dashes() {
  local root="$1" em_dash en_dash found status path
  em_dash="$(printf '\342\200\224')"
  en_dash="$(printf '\342\200\223')"
  set +e
  found="$(grep -rIl "${grep_skips[@]}" -e "$em_dash" -e "$en_dash" "$root")"
  status=$?
  set -e
  if [ "$status" -gt 1 ]; then
    echo "grep failed while looking for em-dashes"
    return 2
  fi
  if [ -n "$found" ]; then
    echo "em-dashes or en-dashes found; this repo bans both (use a colon, comma or parentheses):"
    while IFS= read -r path; do
      echo "  ${path#"$root"/}"
    done <<EOF
$found
EOF
    return 1
  fi
}

run() {
  local name="$1" root="$2"
  case "$name" in
    toolchain) toolchain "$root" ;;
    lint-configs) lint_configs "$root" ;;
    no-baselines) no_baselines "$root" ;;
    em-dashes) em_dashes "$root" ;;
    *)
      echo "unknown guard: $name"
      return 2
      ;;
  esac
}

name="${1:-all}"
root="${2:-$repo}"
if [ "$name" = all ]; then
  failed=0
  for guard in toolchain lint-configs no-baselines em-dashes; do
    run "$guard" "$root" || failed=1
  done
  exit "$failed"
fi
run "$name" "$root"
